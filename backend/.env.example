# --- Database (Neon Postgres, EU region: AWS Frankfurt aws-eu-central-1) ---
# POOLED url (hostname has -pooler) — the app queries with this:
DATABASE_URL=postgresql+asyncpg://USER:PASS@ep-xxx-pooler.eu-central-1.aws.neon.tech/DBNAME
# DIRECT url (no -pooler) — migrations + seed only:
DATABASE_URL_DIRECT=postgresql://USER:PASS@ep-xxx.eu-central-1.aws.neon.tech/DBNAME

# --- At-rest encryption (Fernet). Backend + worker services ONLY, never frontend. ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: put the NEW key first, keep old keys after it, comma-separated.
ENCRYPTION_KEY=

# --- Extraction (Phase 2 — unused in Phase 0). EU endpoint, synthetic data only. ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://eu.api.openai.com/v1

# --- CORS: your Vercel frontend origin ---
ALLOWED_ORIGINS=http://localhost:5173
