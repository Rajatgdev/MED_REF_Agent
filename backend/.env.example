# --- Database (Neon Postgres, EU region: AWS Frankfurt aws-eu-central-1) ---
# POOLED url (hostname has -pooler) — the app queries with this:
DATABASE_URL=postgresql+asyncpg://USER:PASS@ep-xxx-pooler.eu-central-1.aws.neon.tech/DBNAME
# DIRECT url (no -pooler) — migrations + seed only:
DATABASE_URL_DIRECT=postgresql://USER:PASS@ep-xxx.eu-central-1.aws.neon.tech/DBNAME

# --- At-rest encryption (Fernet). Backend + worker services ONLY, never frontend. ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: put the NEW key first, keep old keys after it, comma-separated.
ENCRYPTION_KEY=

# --- Extraction (Phase 2, ACTIVE). One OpenAI call, SYNTHETIC data only. ---
# Empty key -> extraction abstains and the GP selects manually (never a guess).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Standard endpoint. Use https://eu.api.openai.com/v1 ONLY if your org is enrolled in
# OpenAI EU data residency (eligibility review required); a normal key FAILS there.
OPENAI_BASE_URL=https://api.openai.com/v1

# --- OCR fallback for image-only PDFs / image uploads (Mistral Document AI, EU). Optional. ---
# Key: https://console.mistral.ai . Empty = image PDFs rejected (text PDFs/DOCX/paste still work).
MISTRAL_API_KEY=

# --- Routing (OPTION B, TEMPORARY): hosted OpenRouteService. Free key:
#     https://openrouteservice.org/dev/#/signup  (EU-hosted, Germany).
#     Transit unavailable on ORS. Empty = travel/geocode unavailable, never guessed.
#     MUST revert to self-hosted OSRM/Nominatim/OTP2 before real patient data.
ORS_API_KEY=

# --- CORS: your Vercel frontend origin ---
ALLOWED_ORIGINS=http://localhost:5173
